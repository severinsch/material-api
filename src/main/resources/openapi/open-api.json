    "paths": {
        "/damages": {
            "get": {
                "summary": "Get all Damages",
                "parameters": [
                    {
                        "name": "item_id",
                        "in": "query",
                        "description": "The id of the item to get damages for. Get all Damages if not provided.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A list of damages",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/DamageReport"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "If the item_id parameter is malformed."
                    }
                }
            },
            "post": {
                "summary": "Register new damage",
                "responses": {
                    "201": {
                        "description": "the newly created damage report",
                        "content": {
                            "application/json": {
                                "schema": {
